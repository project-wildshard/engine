# Plan worktrees live at .worktrees/<slug> on plan/<slug> (J221, J240, DEV-SPEED DS6); never part of the
# canonical tree. Every repo tool skips them too (DS11, scripts/worktree-ignore.mjs).
/.worktrees/

# Lifted from singleplayer (P3).
node_modules
dist
.DS_Store
.vercel
.env*
dist-native
dist-drafts
dist-admin
.native-build
# Local capture scratch and an already archived HUD mockup source (the JPEG lives in art/hud/round-7-sword-touch/).
/cap2.png
/iso-test.png
# The reviewed JPEG references are committed; keep lossless local source copies outside Git.
# boot packs: regenerated by every build from the committed assets (scripts/bake-packs.mjs)
public/assets/packs/

# review inbox notes pulled by `pnpm inbox:pull` (scripts/inbox-pull.mjs)
.review/
# Rapier WASM: copied from node_modules by every build (vite/rapier.ts)
public/assets/physics/
# the Basis Universal transcoder for KTX2 textures: copied from three by every build (vite/basis.ts, E157)
public/basis/
# Python bytecode from the pipeline scripts (scripts/horizon-matte/config.py, scripts/look-loop/targets.py)
__pycache__/

# Raw local benchmark runs and rendered scorecard frames stay on disk; commit selected summaries explicitly.

# Blender: the script is the source and the exported GLB is committed; a .blend never is (M10, E315). Inspection
# copies go to ~/.cache/wildshard-blender/ (scripts/blender/build.sh --save-blend); .githooks/pre-commit refuses one.
*.blend
*.blend[0-9]*

# E357 parity harness artifacts
/coverage/

# local caches and raw capture frames (never committed)
/.cache/

# E389: time-lapses are rebuilt from the per-capture folders (scripts/shard-timelapse.py); only the captures are committed

# E362 AG4: the layered TypeScript build's declaration output (tsc -b tsconfig.layers.json)
.tsc-layers/

/public/shardfiles/

# Portable author tools are rebuilt for pack.
/src/sharddev/dist/
/src/sdk/dist/

# SF74 W13 (Jake, G281): API docs and the surface are build outputs of `pnpm gen` (scripts/gen-api.mjs), never committed
/docs/api/
/lint/api-surface.json

# DS1.2: inspectable content-hash scene intermediates never ship or enter git.
**/.wildshard/

# G331: local tool state, logs and temporary merge files are not source.
*.tsbuildinfo
/*.log
/.merge_file_*
# committed-fast-checks.mjs: oxlint config, removed in `finally`; a killed gate leaves it.
/.push-config-*.json
/boot-smoke-results/
/scratchpad/

# G331: raw proof runs and expanded memory dumps stay local; commit summaries.

# G331: stitched sky working panels/logs are reproducible intermediates.
# Keep the selected JPEG references and final panoramas already in git.

# G405: cheap derived outputs are generated by builds, never committed.
/scripts/README.md
/lint/shard-words.generated.json

# G405: pure source-derived WebGPU inventory, emitted before CI checks.
/docs/design/webgpu-port-inventory.md

# Storage policy (docs/process/STORAGE.md): scratch, the media cache and media stay out of Git. Ignoring only prevents
# an accident; scripts/repo-size.mjs is the enforcement.
/tmp/
/media-cache/
/docs/**/*.pdf

/out/

# G454 host catalogue is generated by pnpm gen.
/lint/host-catalogue.generated.json

# SF88g: open-plots generated worlds, one data map per output, and per-output discovery modules.
/public/assets/open-plot-*/map/top.webp

# G508: sunscar-dunes data map outputs.
/public/assets/sunscar-dunes/map/top.webp

# G508: far-reach data map outputs.
/public/assets/far-reach/map/top.webp

# G508: Nalati resting assembly and map are build outputs.
