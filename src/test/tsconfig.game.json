{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "types": [
      "vite/client",
      "node"
    ],
    "rootDir": "../..",
    "outDir": "../../.tsc-layers/game",
