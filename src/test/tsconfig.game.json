    {
      "path": "../../tsconfig.game.json"
    }
  ],
  "include": [
    "../*/game/**/*.test.ts",
    "game/**/*.ts",
    "engine/**/*.ts",
    "../*/game/**/*.d.ts"
  ],
  "exclude": []
}
