#!/usr/bin/env bash
# 1. Outgoing-commit checks: .githooks/check-push.mjs (reads git's ref
#    lines on stdin). Bypasses: ALLOW_BIG=1, ALLOW_SECRET=1.
# 2. The engine changelog (Jake, 2026-11-10): a pushed main or vX.Y.Z tag
#    carries its version's CHANGELOG.md section (src/scripts/changelog.mjs).
# 3. AGENTS.md (J241): .githooks/agents-md.mjs, the same ref lines.
# 4. J375 pin provenance (meta MINI-FLOW MF4): a push to main that changes
#    test/pins/ must match a green origin/plan/* tip, as land's pushes do
#    (.githooks/pin-provenance.mjs). Escape hatch: ALLOW_PIN_PUSH=1.
# 4b. SHARD-COMPAT CP3: src/scripts/format-api-gate.mjs refs (ALLOW_FORMAT_AHEAD=1).
# 5. Push lane (full `pnpm check`): .githooks/run-checks.mjs.
#    Bypass: SKIP_CHECK=1.
# Release tags first read the latest qualifying production nightly (TC22), even when
# the branch-based release helper or a cached gate skips release-check.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
top="$(git rev-parse --show-toplevel)"
hooks="$top/.githooks"
refs="$(cat)"
# LL5 checks the operator's outputs before the clean-copy gate omits them.
if [ -f "$top/src/scripts/local-candidates.ts" ]; then node "$top/src/scripts/local-candidates.ts"; fi
printf '%s\n' "$refs" | node "$hooks/check-push.mjs" "$2"
if [ -f "$top/src/scripts/changelog.mjs" ]; then printf '%s\n' "$refs" | node "$top/src/scripts/changelog.mjs" refs; fi
# SHARD-COMPAT CP3 (J486): API first. A main push that moves the shard-format pin above the API's is refused
# (src/scripts/format-api-gate.mjs). Escape hatch: ALLOW_FORMAT_AHEAD=1.
if [ -f "$top/src/scripts/format-api-gate.mjs" ]; then (cd "$top" && printf '%s\n' "$refs" | node src/scripts/format-api-gate.mjs refs); fi
printf '%s\n' "$refs" | node "$hooks/agents-md.mjs" push
printf '%s\n' "$refs" | node "$hooks/pin-provenance.mjs"
# Avoid loading release-only tooling for ordinary pushes (generic hook
# fixtures and non-engine consumers have no src/scripts/release-nightly.ts).
if [[ "$refs" =~ [[:space:]]refs/tags/v[0-9]+\.[0-9]+\.[0-9]+[[:space:]] ]]; then
  printf '%s\n' "$refs" | node "$top/src/scripts/release-nightly.ts" refs
fi
export WS_PUSH_REFS="$refs"
export WS_PUSH_DESTINATION="$2"
exec node "$hooks/run-checks.mjs" push
